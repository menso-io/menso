{
  "name": "menso",
  "displayName": "Menso",
  "version": "1.0.0",
  "description": "AI users run real tasks on your live site and show where they get stuck, with a replay of every step.",
  "author": {
    "name": "Menso",
    "email": "support@menso.io",
    "url": "https://menso.io"
  },
  "homepage": "https://menso.io/docs/mcp",
  "repository": "https://github.com/menso-io/menso",
  "license": "MIT",
  "documentationUrl": "https://menso.io/docs/mcp",
  "privacyPolicyUrl": "https://menso.io/privacy",
  "termsOfServiceUrl": "https://menso.io/terms",
  "keywords": [
    "usability testing",
    "ux testing",
    "ai user testing",
    "ai users",
    "qa",
    "mcp"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Menso API key",
      "description": "Create it at menso.io/settings (Settings, Create API key). Menso shows it once; you can revoke it there.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "menso": {
      "type": "http",
      "url": "https://api.menso.io/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
